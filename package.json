{
  "name": "modlens-plus",
  "version": "3.11.0",
  "description": "Plug-in vision for text-only LLMs (optimized fork of modlens): read_image tool, settings bridge, and Web settings card in one dual-face package",
  "type": "module",
  "bin": {
    "modlens-plus": "./dist/main.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:client": "tsdown -c tsdown.client.mjs",
    "build:all": "pnpm build && pnpm build:client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check src scripts dsh",
    "format": "biome check --write src scripts",
    "eval": "node evals/run.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm build:all",
    "docs:list": "node scripts/docs-list.js"
  },
  "files": [
    "dist",
    "lib",
    "docs",
    "skills/modlens/SKILL.md",
    "skills/modlens/scripts",
    "skills/modlens/references",
    "CHANGELOG.md",
    "SECURITY.md",
    "dsh",
    "client",
    "cordis.patch.yml"
  ],
  "keywords": [
    "cli",
    "vision",
    "ocr",
    "antigravity",
    "agent-skill",
    "claude-code",
    "skill",
    "image-to-text",
    "multimodal",
    "modlens"
  ],
  "author": "Leon Liu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liustack/modlens.git"
  },
  "bugs": {
    "url": "https://github.com/liustack/modlens/issues"
  },
  "homepage": "https://github.com/liustack/modlens#readme",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^13.1.0",
    "undici": "^8.10.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@types/node": "^22.19.7",
    "@types/react": "~18.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "lightningcss": "^1.30.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  }
}
